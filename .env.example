# Copy this file to .env.local. DATABASE_URL or POSTGRES_URL is required.
# Supabase's Vercel integration provides POSTGRES_URL automatically.
# Supabase dashboard > Connect > Transaction pooler (port 6543).
# Replace the password placeholder with a URL-encoded database password.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres

# Optional: Supabase CA certificate as PEM, with literal \n between lines.
# DATABASE_CA_CERT=

# Secure cookies for an HTTPS deployment.
VOCPT_SECURE_COOKIES=true

# Supabase Auth (publishable/anon key only).
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Set this in Vercel's Production environment; leave unset for local development.
# SITE_URL=https://words.repeti.me

# Optional: email of the confirmed account that owns the pre-login learning history.
# LEGACY_PROGRESS_EMAIL=
