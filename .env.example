# Leave unset to keep using local SQLite. Copy this file to .env.local.
# Supabase dashboard > Connect > Transaction pooler (port 6543).
# Replace the password placeholder with a URL-encoded database password.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres

# Optional: Supabase CA certificate as PEM, with literal \n between lines.
# DATABASE_CA_CERT=

# Secure cookies for an HTTPS deployment.
VOCPT_SECURE_COOKIES=true
